{
  "name": "world-view",
  "private": true,
  "description": "World View - a standalone isometric room renderer",
  "author": "Wonderful Digital World",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wonderful-Digital-World/world-view"
  },
  "scripts": {
    "dev": "pnpm --filter @wonderful-digital-world/world-view dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "pnpm --filter @wonderful-digital-world/world-view format",
    "test": "pnpm --filter @wonderful-digital-world/world-view test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "shx": "^0.4.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  }
}
